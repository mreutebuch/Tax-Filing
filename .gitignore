# IMPORTANT: Protects against committing personal tax data.
# DO NOT remove the my-tax-docs/ or analysis/ entries.

# Personal tax documents (NEVER commit)
my-tax-docs/
my tax files/

# Generated analysis (contains personal financial data)
analysis/

# Raw reference PDFs (large, freely available from IRS.gov)
reference/Raw/

# Python
__pycache__/
*.pyc
*.pyo

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Editors
.vscode/
.idea/
*.swp

# IRS forms/instructions/publications as PDFs (freely downloadable; see the matching *.source.txt for title and URL)
reference/curated/*.pdf

# FTB forms/instructions/publications as PDFs (freely downloadable; see the matching *.source.txt)
reference/curated/ca/*.pdf
reference/curated/ca/*.txt
!reference/curated/ca/*.source.txt
